# ==============================================================================
# Auto-analysis-hub Configuration Environment Variables
# ==============================================================================

# Google Gemini API Key for Gemma 4 Multimodal Vision
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Multimodal Model Preference
# Candidates: gemma-4-26b-a4b-it, gemma-4-31b-it, gemini-2.5-flash, gemini-2.0-flash
DEFAULT_MODEL=gemma-4-26b-a4b-it

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
